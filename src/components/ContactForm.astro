---
/**
 * CONTACT FORM — no backend, posted straight to Formspree.
 *
 * ┌────────────────────────────────────────────────────────────────────────┐
 * │ TODO: PASTE YOUR FORMSPREE FORM ID                                     │
 * │                                                                        │
 * │ You do NOT edit this file. The ID lives in one place:                   │
 * │                                                                        │
 * │     src/lib/site.js   ->   formspreeId: 'your-form-id'                  │
 * │                                                                        │
 * │ 1. Sign up at https://formspree.io (the free tier is enough).           │
 * │ 2. New Form -> pick the email enquiries should land in -> Create.       │
 * │ 3. Formspree shows an endpoint like  https://formspree.io/f/abcdwxyz    │
 * │ 4. Copy the last part only ("abcdwxyz") into site.js, replacing         │
 * │    'your-form-id'. Redeploy. Done.                                      │
 * │                                                                        │
 * │ Until then the form validates normally but shows a "not connected yet"  │
 * │ notice instead of pretending to send, so no enquiry is ever lost.       │
 * └────────────────────────────────────────────────────────────────────────┘
 */
import {
  services,
  site,
  formspreeEndpoint,
  formspreeConfigured,
  mailtoHref,
} from '../lib/site.js';

const fieldBase =
  'mt-2 w-full rounded-md border border-line-strong bg-ink px-4 py-3 text-cream placeholder:text-muted/70 transition-colors duration-200 focus:border-amber focus:outline-none aria-[invalid=true]:border-alert';
const labelBase = 'font-display text-sm font-semibold uppercase tracking-[0.14em] text-cream';
const errorBase = 'mt-2 hidden text-sm text-amber';
---

<form
  id="quote-form"
  class="card reveal p-6 sm:p-8"
  action={formspreeEndpoint}
  method="POST"
  data-configured={String(formspreeConfigured)}
>
  <h2 class="text-3xl font-semibold sm:text-4xl">Request a quote</h2>
  <span class="accent-tab mt-4" aria-hidden="true"></span>
  <p class="prose-muted mt-4 text-[0.9375rem]">
    The more you can tell us about the car and what you want fitting, the more
    accurate the quote. Fields marked with an asterisk are required.
  </p>

  <!-- Validation summary, announced to screen readers on submit -->
  <div
    id="form-summary"
    class="mt-6 hidden rounded-md border border-alert/60 bg-alert/10 px-4 py-3 text-[0.9375rem] text-cream"
    role="alert"
  >
  </div>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <div>
      <label class={labelBase} for="name">Name *</label>
      <input
        class={fieldBase}
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="name-error"
        placeholder="Alex Smith"
      />
      <p class={errorBase} id="name-error"></p>
    </div>

    <div>
      <label class={labelBase} for="email">Email *</label>
      <input
        class={fieldBase}
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        aria-describedby="email-error"
        placeholder="you@example.com"
      />
      <p class={errorBase} id="email-error"></p>
    </div>

    <div>
      <label class={labelBase} for="phone">Phone</label>
      <input
        class={fieldBase}
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        aria-describedby="phone-error phone-hint"
        placeholder="07700 900000"
      />
      <p class="mt-2 text-xs text-muted" id="phone-hint">Optional, but quicker for us to answer.</p>
      <p class={errorBase} id="phone-error"></p>
    </div>

    <div>
      <label class={labelBase} for="vehicle">Vehicle make &amp; model</label>
      <input
        class={fieldBase}
        id="vehicle"
        name="vehicle"
        type="text"
        aria-describedby="vehicle-hint"
        placeholder="2019 VW Golf GTI"
      />
      <p class="mt-2 text-xs text-muted" id="vehicle-hint">
        Year and trim help us check compatibility.
      </p>
    </div>

    <div class="sm:col-span-2">
      <label class={labelBase} for="service">Service you are interested in *</label>
      <select
        class={fieldBase}
        id="service"
        name="service"
        required
        aria-describedby="service-error"
      >
        <option value="">Please choose…</option>
        {services.map((service) => <option value={service.name}>{service.name}</option>)}
        <option value="More than one of the above">More than one of the above</option>
        <option value="Something else">Something else</option>
      </select>
      <p class={errorBase} id="service-error"></p>
    </div>

    <div class="sm:col-span-2">
      <label class={labelBase} for="message">Message *</label>
      <textarea
        class={fieldBase}
        id="message"
        name="message"
        rows="5"
        required
        aria-describedby="message-error"
        placeholder="What would you like fitting, and where are you based? If you already have the hardware, tell us the model."
      ></textarea>
      <p class={errorBase} id="message-error"></p>
    </div>
  </div>

  <!-- Spam trap: bots fill this, humans never see it. Formspree honours _gotcha. -->
  <div class="hidden" aria-hidden="true">
    <label for="_gotcha">Leave this field empty</label>
    <input id="_gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="Quote request via promods website" />

  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
    <button type="submit" class="btn btn-primary" id="form-submit">
      <span data-label-idle>Send enquiry</span>
      <span data-label-busy class="hidden">Sending…</span>
    </button>
    <p class="text-sm text-muted">
      We reply to every enquiry. No marketing lists, ever.
    </p>
  </div>

  <!-- Success / failure states -->
  <div
    id="form-success"
    class="mt-6 hidden rounded-md border border-amber/50 bg-amber/10 px-4 py-4"
    role="status"
  >
    <p class="font-display text-lg font-semibold uppercase tracking-wide text-cream">
      Thanks — that's with us
    </p>
    <p class="prose-muted mt-1 text-[0.9375rem]">
      We have your enquiry and will come back to you with a quote. If it is
      urgent, call {site.phone}.
    </p>
  </div>

  <div
    id="form-error"
    class="mt-6 hidden rounded-md border border-alert/60 bg-alert/10 px-4 py-4"
    role="alert"
  >
    <p class="font-display text-lg font-semibold uppercase tracking-wide text-cream">
      That didn't send
    </p>
    <p class="prose-muted mt-1 text-[0.9375rem]" id="form-error-detail"></p>
  </div>
</form>

<!-- mailto: fallback, in case the form ever fails or is blocked -->
<p class="mt-4 text-sm text-muted">
  Rather not use the form? Email us directly at{' '}
  {
    mailtoHref ? (
      <a href={mailtoHref} class="text-amber underline underline-offset-4">
        {site.email}
      </a>
    ) : (
      <span class="text-cream">{site.email}</span>
    )
  }
  {' '}with your vehicle and what you need fitting.
</p>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;

  if (form) {
    // Switch off native bubbles only once we know JS is running, so a no-JS
    // visitor still gets the browser's own required-field checks.
    form.noValidate = true;

    const summary = document.getElementById('form-summary') as HTMLElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const failure = document.getElementById('form-error') as HTMLElement;
    const failureDetail = document.getElementById('form-error-detail') as HTMLElement;
    const submit = document.getElementById('form-submit') as HTMLButtonElement;
    const idle = submit.querySelector('[data-label-idle]') as HTMLElement;
    const busy = submit.querySelector('[data-label-busy]') as HTMLElement;

    type Rule = { id: string; check: (value: string) => string | null };

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    // Deliberately loose: UK numbers get written a dozen different ways.
    const phonePattern = /^[+()\d\s-]{9,}$/;

    const rules: Rule[] = [
      {
        id: 'name',
        check: (v) => (v.trim().length < 2 ? 'Please tell us your name.' : null),
      },
      {
        id: 'email',
        check: (v) =>
          !v.trim()
            ? 'We need an email address to reply to.'
            : !emailPattern.test(v.trim())
              ? 'That email address does not look right.'
              : null,
      },
      {
        id: 'phone',
        check: (v) =>
          v.trim() && !phonePattern.test(v.trim())
            ? 'That phone number does not look right — or leave it blank.'
            : null,
      },
      {
        id: 'service',
        check: (v) => (!v ? 'Please choose the service you are interested in.' : null),
      },
      {
        id: 'message',
        check: (v) =>
          v.trim().length < 10
            ? 'A sentence or two about the job, please.'
            : null,
      },
    ];

    const fieldOf = (id: string) =>
      form.elements.namedItem(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

    const setError = (id: string, message: string | null) => {
      const field = fieldOf(id);
      const error = document.getElementById(`${id}-error`);
      if (!field || !error) return;
      if (message) {
        field.setAttribute('aria-invalid', 'true');
        error.textContent = message;
        error.classList.remove('hidden');
      } else {
        field.removeAttribute('aria-invalid');
        error.textContent = '';
        error.classList.add('hidden');
      }
    };

    // Clear a field's error as soon as the visitor fixes it.
    for (const rule of rules) {
      const field = fieldOf(rule.id);
      field?.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') {
          setError(rule.id, rule.check(String(field.value)));
        }
      });
      field?.addEventListener('change', () => setError(rule.id, rule.check(String(field.value))));
    }

    const validate = () => {
      const failed: string[] = [];
      for (const rule of rules) {
        const field = fieldOf(rule.id);
        const message = field ? rule.check(String(field.value)) : null;
        setError(rule.id, message);
        if (message) failed.push(rule.id);
      }
      if (failed.length) {
        summary.textContent = `Please fix ${failed.length} ${
          failed.length === 1 ? 'field' : 'fields'
        } below before sending.`;
        summary.classList.remove('hidden');
        fieldOf(failed[0])?.focus();
      } else {
        summary.classList.add('hidden');
      }
      return failed.length === 0;
    };

    const setBusy = (state: boolean) => {
      submit.disabled = state;
      idle.classList.toggle('hidden', state);
      busy.classList.toggle('hidden', !state);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      failure.classList.add('hidden');

      if (!validate()) return;

      // Formspree ID not pasted in yet — say so rather than silently failing.
      if (form.dataset.configured !== 'true') {
        failureDetail.textContent =
          'The form is not connected to Formspree yet. Paste your Formspree form ID into src/lib/site.js (see the README), or use the email link below.';
        failure.classList.remove('hidden');
        failure.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      setBusy(true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          success.classList.remove('hidden');
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          const data = await response.json().catch(() => null);
          failureDetail.textContent =
            data?.errors?.map((e: { message: string }) => e.message).join(', ') ||
            'Something went wrong sending your enquiry. Please try again, or email us instead.';
          failure.classList.remove('hidden');
        }
      } catch {
        failureDetail.textContent =
          'We could not reach the form service — check your connection, or email us instead.';
        failure.classList.remove('hidden');
      } finally {
        setBusy(false);
      }
    });
  }
</script>
