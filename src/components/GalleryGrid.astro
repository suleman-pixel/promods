---
import { Image, getImage } from 'astro:assets';
import { url } from '../lib/paths.js';

/**
 * items    — entries from src/lib/gallery.js
 * lightbox — true on the Gallery page (click to enlarge), false for the
 *            home-page teaser, where tiles link through to the Gallery.
 */
const { items, lightbox = false } = Astro.props;

/**
 * Every file in src/assets/gallery is picked up automatically, whatever the
 * extension, and matched to its caption by file name. That is what makes
 * swapping a placeholder for a real photo a drag-and-drop job.
 */
const files = import.meta.glob('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});

const byName = new Map(
  Object.entries(files).map(([path, mod]) => [
    path.split('/').pop().replace(/\.[^.]+$/, ''),
    mod.default,
  ])
);

const missing = [];

const tiles = await Promise.all(
  items.map(async (item) => {
    const image = byName.get(item.file);
    if (!image) {
      missing.push(item.file);
      return null;
    }
    // Full-size version, only fetched when the lightbox opens.
    const full = lightbox
      ? await getImage({
          src: image,
          width: Math.min(1600, image.width),
          format: 'webp',
        })
      : null;
    return { ...item, image, full };
  })
);

const visible = tiles.filter(Boolean);

if (missing.length) {
  console.warn(
    `[gallery] No image file found in src/assets/gallery for: ${missing.join(', ')}. ` +
      `Add the file or remove the entry from src/lib/gallery.js.`
  );
}

const galleryHref = url('gallery/');
---

<ul
  class:list={[
    'grid list-none gap-4 sm:grid-cols-2',
    lightbox ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
  ]}
>
  {
    visible.map((tile, i) => (
      <li class="reveal" data-reveal-delay={Math.min(i, 5) * 70}>
        {lightbox ? (
          <button
            type="button"
            class="group relative block w-full overflow-hidden rounded-xl border border-line bg-surface text-left transition-colors duration-300 hover:border-line-strong"
            data-lightbox-trigger
            data-index={i}
            data-full={tile.full.src}
            data-caption={tile.caption}
            data-alt={tile.alt}
            data-width={tile.image.width}
            data-height={tile.image.height}
          >
            <Image
              src={tile.image}
              alt={tile.alt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-transparent" />
            <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4">
              <span class="font-display text-[0.9375rem] font-semibold uppercase tracking-wide text-cream">
                {tile.caption}
              </span>
              <span
                class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line-strong bg-ink/80 text-cream opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
                aria-hidden="true"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7.5 7.5M3 21l7.5-7.5" />
                </svg>
              </span>
            </span>
            <span class="sr-only">Enlarge image: {tile.caption}</span>
          </button>
        ) : (
          <a
            href={galleryHref}
            class="group relative block overflow-hidden rounded-xl border border-line bg-surface"
          >
            <Image
              src={tile.image}
              alt={tile.alt}
              widths={[320, 640]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/10 to-transparent" />
            <span class="font-display pointer-events-none absolute inset-x-0 bottom-0 p-4 text-[0.9375rem] font-semibold uppercase tracking-wide text-cream">
              {tile.caption}
            </span>
          </a>
        )}
      </li>
    ))
  }
</ul>

{
  lightbox && (
    <dialog
      id="lightbox"
      class="m-auto w-[min(92vw,64rem)] border-0 bg-transparent p-0 backdrop:cursor-zoom-out"
      aria-label="Gallery image viewer"
    >
      <figure class="m-0 flex flex-col">
        <div class="relative">
          <img
            id="lightbox-image"
            src=""
            alt=""
            width="1600"
            height="1200"
            class="mx-auto h-auto max-h-[78vh] w-full rounded-lg object-contain"
          />
          <button
            type="button"
            id="lightbox-prev"
            class="absolute top-1/2 left-2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line-strong bg-ink/85 text-cream transition-colors duration-200 hover:bg-surface-2"
          >
            <span class="sr-only">Previous image</span>
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button
            type="button"
            id="lightbox-next"
            class="absolute top-1/2 right-2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line-strong bg-ink/85 text-cream transition-colors duration-200 hover:bg-surface-2"
          >
            <span class="sr-only">Next image</span>
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
        <div class="mt-3 flex items-center justify-between gap-4 px-1">
          <figcaption
            id="lightbox-caption"
            class="font-display text-base font-semibold uppercase tracking-wide text-cream"
          />
          <button type="button" id="lightbox-close" class="btn btn-ghost btn-sm">
            Close
          </button>
        </div>
      </figure>
    </dialog>
  )
}

<script>
  // Lightbox behaviour. Bails out silently on pages with no triggers (the
  // home-page teaser links straight to the Gallery instead).
  {
      const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')
      );

      if (dialog && triggers.length) {
        const image = document.getElementById('lightbox-image') as HTMLImageElement;
        const caption = document.getElementById('lightbox-caption') as HTMLElement;
        const closeBtn = document.getElementById('lightbox-close');
        const prevBtn = document.getElementById('lightbox-prev');
        const nextBtn = document.getElementById('lightbox-next');
        let current = 0;

        const show = (index: number) => {
          current = (index + triggers.length) % triggers.length;
          const el = triggers[current];
          image.src = el.dataset.full ?? '';
          image.alt = el.dataset.alt ?? '';
          image.width = Number(el.dataset.width ?? 1600);
          image.height = Number(el.dataset.height ?? 1200);
          caption.textContent = `${el.dataset.caption ?? ''} (${current + 1} of ${triggers.length})`;
        };

        triggers.forEach((el, index) => {
          el.addEventListener('click', () => {
            show(index);
            dialog.showModal();
          });
        });

        closeBtn?.addEventListener('click', () => dialog.close());
        prevBtn?.addEventListener('click', () => show(current - 1));
        nextBtn?.addEventListener('click', () => show(current + 1));

        // Arrow keys page through; Escape is handled natively by <dialog>.
        dialog.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(current - 1);
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(current + 1);
          }
        });

        // Clicking the backdrop (i.e. outside the figure) closes the viewer.
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });

        // Free the memory the full-size image was using.
        dialog.addEventListener('close', () => {
          image.removeAttribute('src');
        });
      }
  }
</script>
