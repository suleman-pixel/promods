---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url, nav } from '../lib/paths.js';
import { site } from '../lib/site.js';

const strip = (p) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const here = strip(Astro.url.pathname);
const quoteHref = url('contact/');
---

<header
  class="sticky top-0 z-50 border-b border-line bg-ink/85 backdrop-blur-md supports-[backdrop-filter]:bg-ink/70"
>
  <div class="shell flex h-18 items-center justify-between gap-4">
    <a
      href={url()}
      class="group flex shrink-0 items-center rounded-sm"
      aria-label={`${site.name} — home`}
    >
      <Image
        src={logo}
        alt={`${site.name} logo`}
        width={480}
        densities={[1, 2]}
        loading="eager"
        class="h-9 w-auto transition-opacity duration-300 group-hover:opacity-85 sm:h-10"
      />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => {
          const active = strip(item.href) === here;
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'font-display relative px-3 py-2 text-[1.0625rem] font-semibold uppercase tracking-wide transition-colors duration-200',
                active ? 'text-cream' : 'text-muted hover:text-cream',
              ]}
            >
              {item.label}
              {active && (
                <span
                  class="accent-tab absolute inset-x-3 bottom-0.5 w-auto"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
      <a href={quoteHref} class="btn btn-primary btn-sm ml-4">Get a quote</a>
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-2 lg:hidden">
      <a href={quoteHref} class="btn btn-primary btn-sm hidden sm:inline-flex">
        Get a quote
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-line-strong text-cream transition-colors duration-200 hover:bg-surface-2"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menu</span>
        <svg
          id="nav-icon-open"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          id="nav-icon-close"
          class="hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div id="mobile-nav" hidden class="border-t border-line bg-ink lg:hidden">
    <nav aria-label="Main (mobile)" class="shell flex flex-col py-3">
      {
        nav.map((item) => {
          const active = strip(item.href) === here;
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'font-display border-b border-line py-4 text-xl font-semibold uppercase tracking-wide last:border-b-0',
                active ? 'text-amber' : 'text-cream',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a href={quoteHref} class="btn btn-primary mt-4 mb-2 w-full">Get a quote</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the menu and puts focus back on the button.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      toggle.focus();
    });

    // Reset when the viewport grows past the mobile breakpoint.
    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
