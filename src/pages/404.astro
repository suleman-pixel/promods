---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url, nav } from '../lib/paths.js';
---

<BaseLayout title="Page not found" path="404.html" index={false}>
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-5xl font-semibold sm:text-6xl">That page has moved on</h1>
    <span class="accent-tab mt-6" aria-hidden="true"></span>
    <p class="prose-muted mt-6 max-w-lg text-lg">
      The link you followed does not exist any more. Try one of these instead.
    </p>
    <ul class="mt-8 flex list-none flex-wrap gap-3">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="btn btn-ghost btn-sm">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={url('contact/')} class="btn btn-primary mt-8 self-start">Get a quote</a>
  </section>
</BaseLayout>
