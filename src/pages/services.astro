---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { url } from '../lib/paths.js';
import { services } from '../lib/site.js';
---

<BaseLayout
  title="Services — dash cams, Apple CarPlay, trackers"
  description="Dash cam supply and installation, Apple CarPlay activation and retrofits, and insurance-approved vehicle tracker fitting. Mobile and in-workshop, UK. Contact for a quote."
  path="services/"
>
  <!-- ============================================================ intro -->
  <section class="shell pt-16 pb-12 sm:pt-20">
    <p class="eyebrow reveal">Services</p>
    <h1 class="reveal mt-3 max-w-3xl text-5xl font-semibold sm:text-6xl">
      Fitted so it looks factory
    </h1>
    <span class="accent-tab reveal mt-6" aria-hidden="true"></span>
    <p class="reveal prose-muted mt-6 max-w-2xl text-lg">
      Three specialisms, all on modern vehicles, all finished to the same
      standard: hidden cabling, no cut factory wiring, and everything set up and
      demonstrated before you drive away. Every job is priced on the car in
      front of us, so there are no prices on this page — just ask.
    </p>

    <!-- Jump links: also the anchors linked from the home page cards -->
    <nav aria-label="Jump to a service" class="reveal mt-9">
      <ul class="flex list-none flex-wrap gap-2">
        {
          services.map((service) => (
            <li>
              <a
                href={`#${service.id}`}
                class="font-display inline-flex rounded-md border border-line-strong px-4 py-2 text-sm font-semibold uppercase tracking-[0.12em] text-cream transition-colors duration-200 hover:border-amber hover:bg-surface"
              >
                {service.short}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <hr class="accent-rule" />

  <!-- ========================================================= sections -->
  {
    services.map((service, i) => (
      <section
        id={service.id}
        class:list={[
          'border-b border-line',
          i % 2 === 1 && 'bg-surface/40',
        ]}
        aria-labelledby={`${service.id}-heading`}
      >
        <div class="shell grid gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
          <div class="reveal">
            <p class="eyebrow">0{i + 1}</p>
            <h2 id={`${service.id}-heading`} class="mt-3 text-4xl font-semibold sm:text-5xl">
              {service.name}
            </h2>
            <span class="accent-tab mt-5" aria-hidden="true" />
            <p class="prose-muted mt-6 text-lg">{service.blurb}</p>

            <p class="mt-6 border-l-2 border-amber pl-4 text-[0.9375rem] text-cream">
              {service.useCase}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href={url('contact/')} class="btn btn-primary">Contact for a quote</a>
              <a href={url('gallery/')} class="btn btn-ghost">See example installs</a>
            </div>
          </div>

          <div class="card reveal p-6 sm:p-8" data-reveal-delay="120">
            <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-amber">
              What's included
            </h3>
            <ul class="mt-6 list-none space-y-4">
              {service.includes.map((item) => (
                <li class="flex gap-3">
                  <svg
                    class="mt-1 h-4 w-4 shrink-0 text-amber"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 12.5l5 5L20 6.5" />
                  </svg>
                  <span class="prose-muted text-[0.9375rem]">{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-8 border-t border-line pt-6 text-sm text-muted">
              Hardware can be supplied by us or brought by you.{' '}
              <a href={url('contact/')} class="text-amber underline underline-offset-4">
                Contact for a quote
              </a>
              .
            </p>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand
    title="Not sure which option your car takes?"
    body="Send us the make, model, year and trim — or the registration — and we will tell you what is actually possible before you spend anything."
  />
</BaseLayout>
